{
  "name": "b7-studio-cinema",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "B7 Studio Cinema - estudio gratuito de animacoes cartoon 2D/3D para Shorts, Reels e TikTok",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "vite build",
    "preview": "vite preview --port 4173 --host 127.0.0.1",
    "test": "node tests/run.mjs",
    "render": "node local-renderer/render.mjs",
    "render:frames": "node local-renderer/render.mjs",
    "render:encode": "node local-renderer/encode.mjs",
    "demo": "node local-renderer/render.mjs public/presets/derinkuyu.b7.json --video out/derinkuyu-1080.mp4",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "three": "0.160.1"
  },
  "devDependencies": {
    "playwright": "^1.49.0",
    "pngjs": "^7.0.0",
    "vite": "^5.4.11"
  }
}
